{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniBot Bluetooth control page",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/web_ui.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/vision",
      "args": [],
      "serverReadyAction": {
        "pattern": "open (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Make AprilTag 5in",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vision/make_tag.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/vision",
      "args": [
        "--id",
        "0",
        "--inches",
        "5"
      ]
    }
  ]
}
